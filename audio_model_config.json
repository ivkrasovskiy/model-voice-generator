{
        "model": "glow_tts",
        "run_name": "glow-tts-rel_pos_transformer",
        "run_description": "glow-tts model training with relation position transformer encoder.",

        "audio":{
            "fft_size": 1024,
            "win_length": 1024,
            "hop_length": 256,
            "frame_length_ms": null,
            "frame_shift_ms": null,
            "sample_rate": 22050,
            "preemphasis": 0.0,
            "ref_level_db": 0,
            "power": 1.1,
            "griffin_lim_iters": 60,

            "do_trim_silence": true,
            "trim_db": 60,

            "num_mels": 80,
            "mel_fmin": 50.0,
            "mel_fmax": 7600.0,
            "spec_gain": 1.0,

            "signal_norm": false,
            "min_level_db": -100,
            "symmetric_norm": true,
            "max_norm": 1.0,
            "clip_norm": true,
            "stats_path": null
        },

        "characters": {
            "pad": "_",
            "eos": "~",
            "bos": "^",
            "characters": "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!'(),-.:;? ",
            "punctuations": "!'(),-.:;? ",
            "phonemes": "abcdefhijklmnopqrstuvwxyz\u00e6\u00e7\u00f0\u00f8\u0127\u014b\u0153\u01c0\u01c1\u01c2\u01c3\u0250\u0251\u0252\u0253\u0254\u0255\u0256\u0257\u0258\u0259\u025a\u025b\u025c\u025e\u025f\u0260\u0261\u0262\u0263\u0264\u0265\u0266\u0267\u0268\u026a\u026b\u026c\u026d\u026e\u026f\u0270\u0271\u0272\u0273\u0274\u0275\u0276\u0278\u0279\u027a\u027b\u027d\u027e\u0280\u0281\u0282\u0283\u0284\u0288\u0289\u028a\u028b\u028c\u028d\u028e\u028f\u0290\u0291\u0292\u0294\u0295\u0298\u0299\u029b\u029c\u029d\u029f\u02a1\u02a2\u02c8\u02cc\u02d0\u02d1\u02de\u03b2\u03b8\u03c7\u1d7b\u2c71"
        },

        "add_blank": false,

        "distributed":{
            "backend": "nccl",
            "url": "tcp:\/\/localhost:54321"
        },

        "reinit_layers": [],

        "hidden_channels_encoder": 192,
        "hidden_channels_decoder": 192,
        "hidden_channels_duration_predictor": 256,
        "use_encoder_prenet": true,
        "encoder_type": "rel_pos_transformer",
        "encoder_params": {
            "kernel_size":3,
            "dropout_p": 0.1,
            "num_layers": 6,
            "num_heads": 2,
            "hidden_channels_ffn": 768,
            "input_length": null
        },

        "batch_size": 32,
        "eval_batch_size":16,
        "r": 1,
        "loss_masking": true,
        "mixed_precision": true,
        "data_dep_init_iter": 10,

        "run_eval": true,
        "test_delay_epochs": 0,
        "test_sentences_file": null,

        "noam_schedule": true,
        "grad_clip": 5.0,
        "epochs": 10000,
        "lr": 1e-3,
        "wd": 0.000001,
        "warmup_steps": 4000,
        "seq_len_norm": false,

        "print_step": 25,
        "tb_plot_step": 100,
        "print_eval": false,
        "save_step": 5000,
        "checkpoint": true,
        "tb_model_param_stats": false,

        "text_cleaner": "phoneme_cleaners",
        "enable_eos_bos_chars": false,
        "num_loader_workers": 4,
        "num_val_loader_workers": 4,
        "batch_group_size": 0,
        "min_seq_len": 3,
        "max_seq_len": 500,
        "compute_f0": false,
        "use_noise_augment": true,
        "compute_input_seq_cache": true,

        "output_path": "/home/erogol/Models/LJSpeech/",

        "phoneme_cache_path": "/home/erogol/Models/phoneme_cache/",
        "use_phonemes": true,
        "phoneme_language": "en-us",
        "phonemizer": "gruut",

        "use_speaker_embedding": false,
        "use_external_speaker_embedding_file": false,
        "style_wav_for_test": null,
        "use_gst": false,

        "datasets":
            [
                {
                    "name": "ljspeech",
                    "path": "/home/erogol/Data/LJSpeech-1.1/",
                    "meta_file_train": "metadata.csv",
                    "meta_file_val": null
                }
            ]
    }


